#!/bin/bash

#SBATCH -J E_rotation
#SBATCH -o job.%j.out
#SBATCH -e job.%j.err
#SBATCH -p quantum
#SBATCH -w x10
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=50
#SBATCH -t 24:00:00

# -------------------------------------------------
# Intel MPI environment for Pymablock/MUMPS
# -------------------------------------------------
if [ -f /opt/intel/oneapi/mpi/2021.15/env/vars.sh ]; then
    source /opt/intel/oneapi/mpi/2021.15/env/vars.sh
else
    export PATH=/opt/intel/oneapi/mpi/2021.15/bin:$PATH
    export LD_LIBRARY_PATH=/opt/intel/oneapi/mpi/2021.15/lib:$LD_LIBRARY_PATH
fi

# -------------------------------------------------
# Prevent cluster Python packages from interfering
# with the Conda environment
# -------------------------------------------------
unset PYTHONPATH

# -------------------------------------------------
# Prevent nested threading
# -------------------------------------------------
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

# -------------------------------------------------
# Python environment
# -------------------------------------------------
source /u0/anirban/miniconda3/etc/profile.d/conda.sh
conda activate base

# -------------------------------------------------
# Diagnostics
# -------------------------------------------------
echo "=========================================="
echo "Job ID         : $SLURM_JOB_ID"
echo "Node           : $(hostname)"
echo "Python         : $(which python3)"
echo "Python version : $(python3 --version)"
echo "Allocated CPUs : $SLURM_CPUS_PER_TASK"
echo "PYTHONPATH     : $PYTHONPATH"

python3 -c "import typing_extensions; print('typing_extensions:', typing_extensions.__file__)"

echo "=========================================="

# -------------------------------------------------
# Run calculation
# -------------------------------------------------
python3 main_E_rotation_theta.py
