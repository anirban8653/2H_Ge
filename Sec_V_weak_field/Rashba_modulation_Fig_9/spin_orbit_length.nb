Cell[BoxData[{
 RowBox[{
  RowBox[{"Ez", " ", "=", " ", 
   RowBox[{"rashbaz", "[", 
    RowBox[{"[", 
     RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"alphaz", " ", "=", " ", 
   RowBox[{
    RowBox[{"rashbaz", "[", 
     RowBox[{"[", 
      RowBox[{";;", ",", "2"}], "]"}], "]"}], "*", "100"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"meV", " ", "nm"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"alphazprime", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"alphaz", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], " ", "-", " ", 
       RowBox[{"alphaz", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "*", 
     RowBox[{"1000", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Ez", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], " ", "-", 
        RowBox[{"Ez", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"meV", " ", 
    RowBox[{"nm2", "/", "V"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"Ey", ",", "alphay"}], "}"}], "]"}], "]"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<\[Alpha]' = \>\"", ",", " ", 
    RowBox[{"SetPrecision", "[", 
     RowBox[{"alphazprime", ",", "5"}], "]"}], ",", 
    " ", "\"\< meV nm2/V\>\""}], "]"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Spin", "\[Dash]", 
    RowBox[{
     RowBox[{"orbit", " ", 
      RowBox[{"length", ":", " ", "lSO"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"hbar", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"m", "*"}], " ", "|", "alpha", "|"}], ")"}]}]}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<Calculating spin\[Dash]orbit length:\>\"", "]"}], ";"}],
   "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"my", " ", "=", " ", "0.524"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"mass", " ", "along", " ", "x"}], ",", " ", 
    RowBox[{"in", " ", "units", " ", "of", " ", "m0"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hbar2OverM0", " ", "=", " ", "76.19964"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"meV", " ", 
    RowBox[{"nm", "^", "2"}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Start", " ", "at", " ", "the", " ", "second", " ", "data", " ", 
     "point"}], ",", " ", 
    RowBox[{"as", " ", "in", " ", "your", " ", "original", " ", "code"}]}], 
   " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lsoValues", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"If", "[", "\n", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"alphaz", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", "==", " ", "0"}], ",", "\n", 
        "     ", "Infinity", ",", "\n", "     ", 
        RowBox[{"hbar2OverM0", "/", 
         RowBox[{"(", 
          RowBox[{"my", "*", 
           RowBox[{"Abs", "[", 
