      RowBox[{"hbar", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"m", "*"}], " ", "|", "alpha", "|"}], ")"}]}]}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<Calculating spin\[Dash]orbit length:\>\"", "]"}], ";"}],
   "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"my", " ", "=", " ", "0.0672"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"mass", " ", "along", " ", "x"}], ",", " ", 
    RowBox[{"in", " ", "units", " ", "of", " ", "m0"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hbar2OverM0", " ", "=", " ", "76.19964"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"meV", " ", 
    RowBox[{"nm", "^", "2"}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Start", " ", "at", " ", "the", " ", "second", " ", "data", " ", 
     "point"}], ",", " ", 
    RowBox[{"as", " ", "in", " ", "your", " ", "original", " ", "code"}]}], 
   " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lsoValues", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"If", "[", "\n", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"alphay", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", "==", " ", "0"}], ",", "\n", 
        "     ", "Infinity", ",", "\n", "     ", 
        RowBox[{"hbar2OverM0", "/", 
         RowBox[{"(", 
          RowBox[{"my", "*", 
           RowBox[{"Abs", "[", 
            RowBox[{"alphay", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "*", "1000"}], ")"}]}]}], 
       "\n", "   ", "]"}], ",", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "2", ",", " ", 
        RowBox[{"Length", "[", "alphay", "]"}]}], "}"}]}], "\n", "]"}]}], 
