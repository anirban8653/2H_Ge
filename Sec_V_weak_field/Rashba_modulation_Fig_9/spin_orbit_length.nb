     RowBox[{
     "Import", "[", "\"\<Pymablock_Z_kx0.001_emax_0.05_N100_L300.dat\>\"", 
      "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"2", " ", ";;"}], "]"}], "]"}]}], ";"}], "\n", "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Ey", " ", "=", " ", 
    RowBox[{"rashbay", "[", 
     RowBox[{"[", 
      RowBox[{";;", ",", " ", "1"}], "]"}], "]"}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"Electric", " ", 
    RowBox[{"field", ":", " ", 
     RowBox[{"V", "/", "\[Mu]m"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"alphay", " ", "=", " ", 
    RowBox[{
     RowBox[{"rashbay", "[", 
      RowBox[{"[", 
       RowBox[{";;", ",", " ", "2"}], "]"}], "]"}], "*", "100"}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Rashba", " ", 
     RowBox[{"coefficient", ":", " ", 
      RowBox[{"eV", " ", "\[CapitalARing]"}]}]}], " ", "->", " ", 
    RowBox[{"meV", " ", "nm"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"alphayprime", " ", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"alphay", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], " ", "-", " ", 
       RowBox[{"alphay", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "*", 
     RowBox[{"1000", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Ey", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], " ", "-", " ", 
        RowBox[{"Ey", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}]}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"Field", "-", 
    RowBox[{"normalized", " ", "Rashba", " ", 
     RowBox[{"coefficient", ":", " ", 
      RowBox[{"meV", " ", 
       RowBox[{
        RowBox[{"nm", "^", "2"}], "/", "V"}]}]}]}]}], " ", "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<\[Alpha]' = \>\"", ",", " ", 
     RowBox[{"NumberForm", "[", 
      RowBox[{"alphayprime", ",", " ", "5"}], "]"}], 
     ",", "\"\< meV nm^2/V\>\""}], "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Plot", " ", "Rashba", " ", "coefficient"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\n", "  ", 
    RowBox[{"ListLinePlot", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"Ey", ",", " ", "alphay"}], "}"}], "]"}], ",", "\n", "    ", 
      RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "    ", 
      RowBox[{"FrameLabel", " ", "->", " ", 
       RowBox[{"{", "\n", "      ", 
        RowBox[{"\"\<Electric field (V/\[Micro]m)\>\"", ",", "\n", 
         "      ", "\"\<Rashba coefficient (meV nm)\>\""}], "\n", "    ", 
        "}"}]}], ",", "\n", "    ", 
      RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", "    ", 
      RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "\n", "  ", "]"}], "\n",
     "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Spin", "\[Dash]", 
    RowBox[{
     RowBox[{"orbit", " ", 
      RowBox[{"length", ":", " ", "lSO"}]}], " ", "=", " ", 
