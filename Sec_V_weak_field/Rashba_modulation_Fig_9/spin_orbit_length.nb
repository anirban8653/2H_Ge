 RowBox[{
  RowBox[{"rashbay", " ", "=", " ", 
   RowBox[{
    RowBox[{
    "Import", "[", "\"\<Pymablock_Y_kx0.001_emax_0.05_N100_L300.dat\>\"", 
     "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"2", " ", ";;"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rashbaz", " ", "=", " ", 
