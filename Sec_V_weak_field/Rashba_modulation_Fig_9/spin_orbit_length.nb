       RowBox[{"Ey", "[", 
        RowBox[{"[", 
         RowBox[{"2", " ", ";;"}], "]"}], "]"}], ",", " ", "lsoValues"}], 
      "}"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\n", "  ", 
